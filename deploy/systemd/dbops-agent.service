[Unit]
Description=DBOps Platform Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dbops-platform
EnvironmentFile=/opt/dbops-platform/.env
ExecStart=/opt/dbops-platform/bin/dbops-agent --config /opt/dbops-platform/config/agent.yaml
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
