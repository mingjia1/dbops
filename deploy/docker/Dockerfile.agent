FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /build/dbops-agent ./cmd/main.go

FROM alpine:latest
RUN apk --no-cache add ca-certificates curl
WORKDIR /opt/dbops-platform
COPY --from=builder /build/dbops-agent ./bin/dbops-agent
EXPOSE 8081
CMD ["./bin/dbops-agent"]
